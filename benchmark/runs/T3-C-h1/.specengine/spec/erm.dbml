// 命名慣例待 manifest 核實，目前暫採 snake_case
// 模組 COUPON：優惠券（多租戶，以 tenant_id 隔離）

Table coupons {
  tenant_id varchar [not null, note: "所屬租戶識別碼，優惠券只能用在同一租戶的訂單；不符時 TENANT_MISMATCH"]
  code varchar [not null, note: "優惠券代碼，同一租戶內唯一；同一次呼叫內重複時 DUPLICATE_COUPON"]
  type varchar [not null, note: "折扣類型。狀態: PERCENT | FIXED"]
  value int [not null, note: "PERCENT: 折扣百分比，整數 1 至 100；FIXED: 折扣金額（整數元），必須大於 0。不合法時 INVALID_COUPON"]
  valid_from timestamp [not null, note: "有效期間起始時刻（ISO 8601），含此時刻"]
  valid_to timestamp [not null, note: "有效期間結束時刻（ISO 8601），含此時刻。必須不早於 valid_from，否則 INVALID_COUPON"]
  stackable boolean [not null, note: "是否可與其他可疊加優惠券同時使用。true: 可疊加；false: 只能單獨使用（NOT_STACKABLE）"]
  min_order_amount int [note: "最低消費金額（整數元）。未設定（NULL）表示無限制；未達時 MIN_ORDER_NOT_MET"]

  indexes {
    (tenant_id, code) [unique, name: "uq_coupons_tenant_code"]
  }
}
